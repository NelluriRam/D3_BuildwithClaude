# Copy this file to .env and fill in your own values. Never commit .env.

# Required: Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used by the SRE and Remediation agents.
# Defaults to a fast/cheap model since this is a cost-conscious demo.
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Port the backend (and, in production, the static frontend) listens on.
PORT=3001

# --- LoopSentinel budget ceilings (enforced in code, not by prompting) ---
# Hard ceiling on cost (USD) a single agent session may spend before it is
# paused for human review.
SESSION_BUDGET_USD=0.50
# Hard ceiling on cost (USD) across all sessions within a rolling hour.
HOURLY_BUDGET_USD=2.00
